{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["supabase/functions/**", "node_modules"]
}
